# Always check for a new version of the pages, so updates show on the next reload
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
/app/manifest.webmanifest
  Cache-Control: no-cache
/app/list/
  Cache-Control: no-store
/app/list/index.html
  Cache-Control: no-store
